{
  "name": "chaveiro-antiperda-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch codigo/server.ts",
    "start": "tsx codigo/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server.js",
    "migrate:cloud": "tsx codigo/migrate-cloud.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test codigo/servicos/servicos.test.ts codigo/rotas/rotas.test.ts codigo/rotas/api.integration.test.ts codigo/intermediarios/idempotenciaOffline.real-db.test.ts ../aplicativo/codigo/utilitarios/regrasFilaSemConexao.test.ts",
    "test:coverage": "c8 --all --include=\"codigo/**/*.ts\" --reporter=text --reporter=json-summary tsx --test codigo/servicos/servicos.test.ts codigo/rotas/rotas.test.ts codigo/rotas/api.integration.test.ts codigo/intermediarios/idempotenciaOffline.real-db.test.ts ../aplicativo/codigo/utilitarios/regrasFilaSemConexao.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "google-auth-library": "^11.3.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.3",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3"
  }
}
