{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "moduleSuffixes": [
      ".native",
      ".web",
      ""
    ],
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
