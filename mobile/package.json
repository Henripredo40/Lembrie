{
  "name": "chaveiro-antiperda-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "build:web": "node scripts/copiar-worker-mapa.mjs && expo export --platform web",
    "test:componentes": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/config-plugins": "~58.0.11",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^58.0.21",
    "expo-asset": "~58.0.19",
    "expo-auth-session": "~58.0.16",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "maplibre-gl": "^6.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-ble-plx": "^3.5.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "testPathIgnorePatterns": ["<rootDir>/src/utilitarios/regrasFilaSemConexao.test.ts"],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/estilos/**",
      "!src/componentes/MapaLibre.*.tsx",
      "!src/componentes/GoogleRecuperacao.*.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ]
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "expo-modules-core": "~58.0.28",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  }
}
