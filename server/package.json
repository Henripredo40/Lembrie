{
  "name": "chaveiro-antiperda-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server.js",
    "migrate:cloud": "tsx src/migrate-cloud.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/servicos/servicos.test.ts src/rotas/rotas.test.ts ../mobile/src/utilitarios/regrasFilaSemConexao.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "google-auth-library": "^11.3.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.3",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3"
  }
}
